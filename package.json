{
  "name": "@lpdfio/lpdf",
  "version": "0.0.0",
  "description": "JavaScript SDK for Lpdf, the PDF engine that renders a document written in XML or built in code to the same PDF in every language.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types":   "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types":  "./dist/browser.d.ts"
    }
  },
  "scripts": {
    "build":         "tsc && node build-browser.mjs && node -e \"require('node:fs').cpSync('./wasm', './dist/wasm', {recursive:true})\"",
    "build:node":    "tsc",
    "build:browser": "node build-browser.mjs",
    "test":          "node --test test/render.test.mjs test/package-entry.test.mjs test/timeout.test.mjs test/memory.test.mjs test/stamp.test.mjs"
  },
  "author": "lpdf.io",
  "homepage": "https://lpdf.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/lpdfio/lpdf-js"
  },
  "bugs": {
    "url": "https://github.com/lpdfio/lpdf/issues"
  },
  "keywords": ["pdf", "wasm", "xml", "document", "lpdf"],
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild":     "^0.25.0",
    "typescript":  "^5.0.0"
  },
  "allowScripts": {
    "esbuild": false
  }
}
